# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI Services
GEMINI_API_KEY=

# Pinecone Vector Database
PINECONE_API_KEY=
PINECONE_INDEX_NAME=your-current-index-name

# Legacy Pinecone Indexes (comma-separated, optional)
# Used for backward compatibility with old namespaces
# New data will be written to PINECONE_INDEX_NAME, but queries will check these legacy indexes too
PINECONE_LEGACY_INDEX_NAMES=old-index-1,old-index-2

# Version Configuration
# Note: Version cutoff date is configured in src/constants/VersionConfig.ts
# Chats created before the cutoff date (default: 2024-09-15) are read-only due to embedding model changes

# Site Configuration
SITE_URL=