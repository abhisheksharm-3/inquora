# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI Services
GEMINI_API_KEY=

# Pinecone Vector Database
PINECONE_API_KEY=
PINECONE_INDEX_NAME=your-current-index-name

# Legacy Pinecone Indexes (comma-separated, optional)
PINECONE_LEGACY_INDEX_NAMES=

# Multiutility API (custom subtitle/embedding server)
# Optional - defaults to https://abhisheksan-multiutility-server.hf.space
MULTIUTILITY_API_URL=
MULTIUTILITY_API_KEY=your-api-key-here

# Site Configuration
SITE_URL=

# Rate limiting (optional - uses Upstash Redis for serverless)
# When unset, in-memory fallback is used (not shared across serverless invocations)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=