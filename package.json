{
  "name": "inquora",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:types": "supabase gen types typescript --linked > src/core/database.types.ts",
    "db:test": "bun run scripts/run-pgtap.ts",
    "db:push": "supabase db push --linked",
    "eval": "bun run scripts/eval-retrieval.ts",
    "live": "bun run scripts/live-answer.ts",
    "live:deployed": "bun run scripts/live-deployed.ts"
  },
  "description": "Inquora – Chat with documents, videos, and more using AI.",
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@langchain/core": "^1.1.5",
    "@langchain/google-genai": "^2.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@remixicon/react": "^4.7.0",
    "@sentry/nextjs": "^10.73.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.87.1",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@upstash/redis": "^1.34.0",
    "@vercel/otel": "^2.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "langchain": "^1.2.0",
    "lucide-react": "^0.561.0",
    "mammoth": "^1.12.2",
    "motion": "^12.23.26",
    "next": "^16.0.10",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.68.0",
    "tailwind-merge": "^3.4.0",
    "undici": "^8.10.1",
    "unpdf": "^1.8.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@opentelemetry/api": "^1.9.1",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.0",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "eslint-plugin-boundaries": "^7.2.0",
    "prettier": "^3.9.6",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
